# Firebase config — get these from Firebase Console → Project Settings → Your apps
# Copy this file to .env.qa and fill in your values for local dev.
# For CI/CD, add these as GitHub repository secrets (Settings → Secrets → Actions).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# CricAPI — https://www.cricapi.com (free tier: 100 req/day)
VITE_CRICAPI_KEY=
